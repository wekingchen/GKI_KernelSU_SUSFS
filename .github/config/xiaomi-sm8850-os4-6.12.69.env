OS4_GKI_COMMON_COMMIT=e2b8ca7c8d0551a6124b1a7322f5ae532845f1b5
OS4_GKI_EXPECTED_CLANG=r536225
OS4_SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
