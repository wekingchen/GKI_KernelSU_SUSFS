# Xiaomi 17 Pro / pandora, observed stock HyperOS 4 / Android 17.
# This file is for experimental OS4 source discovery only. It is NOT a
# replacement for .github/config/xiaomi-sm8850-android16-6.12.23.env.
# These values are hard-pinned and must be verified in CI before porting.
OS4_DEVICE=pandora
OS4_SYSTEM_BUILD=OS4.0.5.0.XBLCNXM
