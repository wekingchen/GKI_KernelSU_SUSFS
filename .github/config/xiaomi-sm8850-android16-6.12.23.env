# Xiaomi 17 series (SM8850) Android 16 / Linux 6.12.23 reproducible build pins.
# Device-specific values live here so the generic upstream-tracking workflows
# can remain untouched.

TARGET_FAMILY=sm8850
ANDROID_VERSION=16
ANDROID_BRANCH=android16
KERNEL_VERSION=6.12.23
KERNEL_SERIES=6.12
KMI_GENERATION=5
PAGE_SIZE=4096
CLANG_VERSION=r536225

XIAOMI_17_CODENAME=pudding
XIAOMI_17_PRO_CODENAME=pandora
XIAOMI_17_PRO_MAX_CODENAME=popsicle
SUPPORTED_DEVICES="pudding pandora popsicle"

# Observed stock release from Xiaomi 17 Pro OS3.0.319.0.WBLCNXM.
# This is an audit reference only: g75e9... is not claimed to be a public ACK
# commit until its exact public provenance can be demonstrated.
EXPECTED_STOCK_RELEASE=6.12.23-android16-5-g75e9b1c7ae7c-abogki463945075-4k

# Source profile used when workflow input is omitted.
# gold-cctv = public source family used by the known-booting Gold package.
# ack-r51   = late official ACK 2025-06 respin kept as a clean control.
DEFAULT_SOURCE_PROFILE=gold-cctv

# Build/tooling manifest. Both source profiles use the same pinned ACK build
# infrastructure and r536225 toolchain; only common/ is switched.
ACK_MANIFEST_URL=https://android.googlesource.com/kernel/manifest
ACK_MANIFEST_BRANCH=common-android16-6.12-2025-06
ACK_MANIFEST_COMMIT=a17736b7c5c2ce7435426183f1b376e85d59ba7e

# Clean official ACK control.
ACK_COMMON_REPO=https://android.googlesource.com/kernel/common
ACK_COMMON_SYNC_REF=deprecated/android16-6.12-2025-06
ACK_COMMON_REF=refs/tags/android16-6.12-2025-06_r51
ACK_COMMON_COMMIT=5a0e85dd9db068df8f0cdff9be76fe4211bd8af9

# Public GKI source family used by cctv18's Xiaomi/OPPO/OnePlus/Realme 6.12.23
# GKI build path referenced by the Droidspaces community device table.
# Pin the commit: never build a moving branch in the Xiaomi lane.
GOLD_COMMON_REPO=https://github.com/cctv18/android_gki_kernel_common.git
GOLD_COMMON_BRANCH=android16-6.12-2025-06
GOLD_COMMON_COMMIT=9e91eb74a201e8cee839c8db6d642ff9b8408388

# Xiaomi GPL/BSP reference. MiCode's popsicle-w-oss is useful for the SM8850
# vendor/BSP side, but its root kernel tree is 6.11 and is not the boot Image
# source for this 6.12.23 GKI target.
XIAOMI_MICODE_REPO=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
XIAOMI_MICODE_BRANCH=popsicle-w-oss
XIAOMI_PLATFORM_RELEASE=release-w-qcom-sm8850

# ReSukiSU + SUSFS immutable pair.
RESUKISU_REPO=https://github.com/ReSukiSU/ReSukiSU.git
RESUKISU_COMMIT=3c1882886dbbb54f4aae7ddf205f8ccde32c2a34
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12
SUSFS_COMMIT=7d91da2d2ce056d1abf378d9199aaf1072d37ab0

# Conservative boot-only AnyKernel3 base.
ANYKERNEL3_REPO=https://github.com/osm0sis/AnyKernel3.git
ANYKERNEL3_COMMIT=dca9dc370838d919d56c1f59ec78b27a14a72c68
