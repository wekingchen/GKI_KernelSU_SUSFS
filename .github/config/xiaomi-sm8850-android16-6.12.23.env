# Xiaomi 17 series (SM8850) Android 16 / Linux 6.12.23 reproducible build pins.
# Device-specific values live here so generic upstream-tracking workflows remain untouched.

TARGET_FAMILY=sm8850
ANDROID_VERSION=16
ANDROID_BRANCH=android16
KERNEL_VERSION=6.12.23
KERNEL_SERIES=6.12
KMI_GENERATION=5
PAGE_SIZE=4096
CLANG_VERSION=r536225

XIAOMI_17_CODENAME=pudding
XIAOMI_17_PRO_CODENAME=pandora
XIAOMI_17_PRO_MAX_CODENAME=popsicle
SUPPORTED_DEVICES="pudding pandora popsicle"

# Observed stock release from Xiaomi 17 Pro OS3.0.319.0.WBLCNXM.
EXPECTED_STOCK_RELEASE=6.12.23-android16-5-g75e9b1c7ae7c-abogki463945075-4k

# Default daily-use path. Both profiles boot on pandora; Gold remains the
# default because it has the broader accumulated runtime validation.
DEFAULT_SOURCE_PROFILE=gold-cctv

# Keep source KMI state and final build policy distinct in provenance.
GOLD_KMI_MODE=modversions-gendwarfksyms
ACK_SOURCE_KMI_MODE=kleaf-strict
ACK_XIAOMI_KMI_MODE=kleaf-xiaomi-compat

# Official ACK R51 source. The source target is verified in its stock strict
# form before the Xiaomi build layer relaxes trimming/protected-module policy
# for vendor compatibility.
ACK_MANIFEST_URL=https://android.googlesource.com/kernel/manifest
ACK_MANIFEST_BRANCH=common-android16-6.12-2025-06
ACK_MANIFEST_COMMIT=a17736b7c5c2ce7435426183f1b376e85d59ba7e
ACK_COMMON_REPO=https://android.googlesource.com/kernel/common
ACK_COMMON_SYNC_REF=deprecated/android16-6.12-2025-06
ACK_COMMON_REF=refs/tags/android16-6.12-2025-06_r51
ACK_COMMON_COMMIT=5a0e85dd9db068df8f0cdff9be76fe4211bd8af9

# Gold-compatible public source family. This path intentionally follows the
# proven cctv18 build style: standalone make gki_defconfig + Image, not Kleaf
# kernel_aarch64_dist. The commit is pinned so the branch cannot drift.
GOLD_COMMON_REPO=https://github.com/cctv18/android_gki_kernel_common.git
GOLD_COMMON_BRANCH=android16-6.12-2025-06
GOLD_COMMON_COMMIT=9e91eb74a201e8cee839c8db6d642ff9b8408388
GOLD_KERNEL_LOCALVERSION=-android16-5-g9e91eb74a201-xiaomi-4k

# Same public r536225 toolchain bundle used by cctv18's 6.12.23 GKI workflow.
GOLD_TOOLCHAIN_BASE=https://github.com/cctv18/oneplus_sm8650_toolchain/releases/download/LLVM-Clang19-r536225
GOLD_CLANG_ARCHIVE=clang-r536225.zip
GOLD_RUST_ARCHIVE=rust.zip
GOLD_BUILD_TOOLS_ARCHIVE=build-tools.zip

# Xiaomi GPL/BSP reference only; its root kernel tree is 6.11.
XIAOMI_MICODE_REPO=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
XIAOMI_MICODE_BRANCH=popsicle-w-oss
XIAOMI_PLATFORM_RELEASE=release-w-qcom-sm8850

# BakaSU (formerly ReSukiSU) follows upstream main by default, matching the
# generic "Android 内核构建-自定义" workflow. Each build records the resolved
# commit and calculated KSU version code for reproducibility. The historical
# #62 rollback commit predates the rename but remains in the same repository
# history and was physically boot-tested on pandora with Manager/root working.
BAKASU_REPO=https://github.com/Baka-SU/BakaSU.git
BAKASU_DEFAULT_REF=main
BAKASU_LAST_KNOWN_GOOD_COMMIT=fa8311f632a215b5381ec644627c6198d1e8a13e

# Match the generic custom workflow: track the kernel-specific SUSFS branch by
# default and record the exact resolved commit in every build. #63 was
# physically boot-tested on pandora with SUSFS v2.3.0 visible and working.
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_DEFAULT_REF=gki-android16-6.12
SUSFS_LAST_KNOWN_GOOD_COMMIT=b213c54126fb243595ce7876e91d84d6e0861fec
SUSFS_PREVIOUS_PINNED_COMMIT=7d91da2d2ce056d1abf378d9199aaf1072d37ab0

# Optional feature sources track named upstream refs by default. Builds record
# the resolved commit for every moving dependency so a result can be traced.
NOMOUNT_REPO=https://github.com/maxsteeel/nomount.git
NOMOUNT_DEFAULT_REF=dev
DROIDSPACES_REPO=https://github.com/ravindu644/Droidspaces-OSS.git
DROIDSPACES_DEFAULT_REF=main
NTSYNC_PATCH_REPO=https://github.com/Goldzxcbug/Droidspaces_Kernel_patch.git
NTSYNC_PATCH_DEFAULT_REF=main
ZRAM_FEATURE_REPO=https://github.com/cctv18/oppo_oplus_realme_sm8850.git
ZRAM_FEATURE_DEFAULT_REF=main
BBG_REPO=https://github.com/vc-teahouse/Baseband-guard.git
BBG_DEFAULT_REF=main
REKERNEL_REPO=https://github.com/Sakion-Team/Re-Kernel.git
REKERNEL_DEFAULT_REF=main

# Pinned SHA256 digests published by the r536225 GitHub release assets.
GOLD_CLANG_SHA256=574ef505fa9222c24bb75a9c6592fd62ca546bd86267f73b5533ec38a239f0ea
GOLD_RUST_SHA256=4adf5f226cd4ac4840f454955b52b07e99a198a859efe635194e89e7c35c3f41
GOLD_BUILD_TOOLS_SHA256=821babb745321981222d0cb42af5c1214e4efc908b159ae82dbd8113d978c7dd

# Physical full-stack milestone: workflow run #76 (commit adce911ce19573f148ada2c066f2b52b93a97bdf)
# booted on pandora with no immediate abnormal behavior. This proves boot/basic-use
# compatibility only; optional feature runtime behavior is tracked separately.

# Conservative boot-only AnyKernel3 base.
ANYKERNEL3_REPO=https://github.com/osm0sis/AnyKernel3.git
ANYKERNEL3_COMMIT=dca9dc370838d919d56c1f59ec78b27a14a72c68
